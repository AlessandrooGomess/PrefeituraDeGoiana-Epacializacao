generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL ")
}

enum Role {
    ADMIN
    ENGENHEIRO
    CIDADAO
}

enum StatusObra {
    PLANEJADA
    ORDEM_EMITIDA
    EM_ANDAMENTO
    PARALISADA
    CONCLUIDA
}

enum TipoFoto {
    RENDER_PROJETO
    ANTES
    EM_ANDAMENTO
    CONCLUIDO
}