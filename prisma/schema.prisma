generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  GESTAO
  ADM_SECRETARIA
  ENGENHEIRO
  CIDADAO
}

enum StatusObra {
  PLANEJADA
  ORDEM_EMITIDA
  EM_ANDAMENTO
  PARALISADA
  CONCLUIDA
}

enum TipoFoto {
  RENDER_PROJETO
  ANTES
  EM_ANDAMENTO
  CONCLUIDO
}

enum TipoIntercorrencia {
  CHUVA
  ATRASO_MATERIAL
  FALTA_PESSOAL
  ACIDENTE_TRABALHO
  PROBLEMA_FORNECEDOR
  OUTROS
}

enum StatusRegistro {
  RASCUNHO
  ENVIADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  PARALISADA
}

model Usuario {
  id           String      @id @default(uuid())
  nome         String
  email        String      @unique
  passwordHash String?     @map("password_hash")
  cargo        String?
  telefone     String?
  ativo        Boolean     @default(true)
  role         Role        @default(CIDADAO)
  createdAt    DateTime    @default(now()) @map("created_at")
  secretariaId String?     @map("secretaria_id")
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  obrasFiscalizadas Obra[]    @relation("EngenheiroObra")
  medicoes          Medicao[]
  registrosCampo    RegistroCampo[] @relation("EngenheiroRegistros")
  fotosEnviadas     Foto[]    @relation("UsuarioFotos")

  @@map("usuarios")
}

model Secretaria {
  id               String   @id @default(uuid())
  nome             String
  sigla            String
  corIdentificacao String?  @map("cor_identificacao")
  createdAt        DateTime @default(now()) @map("created_at")

  eixoId String?          @map("eixo_id")
  eixo   EixoEstrategico? @relation(fields: [eixoId], references: [id], onDelete: SetNull)

  areaTematicaId String?       @map("area_tematica_id")
  areaTematica   AreaTematica? @relation(fields: [areaTematicaId], references: [id], onDelete: SetNull)

  obras    Obra[]
  usuarios Usuario[]

  @@map("secretarias")
}

model EixoEstrategico {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  cor       String?  @default("#3182CE")
  descricao String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  areas       AreaTematica[]
  obras       Obra[]
  secretarias Secretaria[]

  @@map("eixos_estrategicos")
}

model AreaTematica {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  eixoId String          @map("eixo_id")
  eixo   EixoEstrategico @relation(fields: [eixoId], references: [id], onDelete: Cascade)

  obras       Obra[]
  secretarias Secretaria[]

  @@map("areas_tematicas")
}

model Obra {
  id                 String     @id @default(uuid())
  titulo             String
  descricao          String?    @db.Text
  endereco           String
  bairro             String
  latitude           Float
  longitude          Float
  valorContrato      Decimal?   @map("valor_contrato") @db.Decimal(12, 2)
  empresaContratada  String?    @map("empresa_contratada")
  numeroOrdemServico String?    @map("numero_ordem_servico")
  dataOrdemServico   DateTime?  @map("data_ordem_servico")
  previsaoConclusao  DateTime?  @map("previsao_conclusao")
  dataConclusaoReal  DateTime?  @map("data_conclusao_real")
  status             StatusObra @default(PLANEJADA)
  deletedAt          DateTime?  @map("deleted_at")

  secretariaId String     @map("secretaria_id")
  secretaria   Secretaria @relation(fields: [secretariaId], references: [id])

  eixoId String?          @map("eixo_id")
  eixo   EixoEstrategico? @relation(fields: [eixoId], references: [id], onDelete: SetNull)

  areaTematicaId String?       @map("area_tematica_id")
  areaTematica   AreaTematica? @relation(fields: [areaTematicaId], references: [id], onDelete: SetNull)

  engenheiroId String?  @map("engenheiro_id")
  engenheiro   Usuario? @relation("EngenheiroObra", fields: [engenheiroId], references: [id])

  tipoObraId String?   @map("tipo_obra_id")
  tipoObra   TipoObra? @relation(fields: [tipoObraId], references: [id], onDelete: SetNull)

  etapasObra EtapaObra[]

  medicoes Medicao[]
  registrosCampo    RegistroCampo[]
  fotos             Foto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("obras")
}

model Medicao {
  id                  String   @id @default(uuid())
  obraId              String   @map("obra_id")
  obra                Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  engenheiroId        String   @map("engenheiro_id")
  engenheiro          Usuario  @relation(fields: [engenheiroId], references: [id])
  dataVistoria        DateTime @default(now()) @map("data_vistoria")
  percentualExecutado Decimal  @map("percentual_executado") @db.Decimal(5, 2)
  observacoesTecnicas String?  @map("observacoes_tecnicas") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("medicoes")
}

model Foto {
  id        String   @id @default(uuid())
  obraId    String   @map("obra_id")
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation("UsuarioFotos", fields: [usuarioId], references: [id], onDelete: SetNull)

  url       String
  tipo      TipoFoto @default(EM_ANDAMENTO)
  descricao String?
  dataFoto  DateTime @default(now()) @map("data_foto")
  createdAt DateTime @default(now()) @map("created_at")
  latitude        Float?
  longitude       Float?
  registroCampoId String?        @map("registro_campo_id")
  registroCampo   RegistroCampo? @relation(fields: [registroCampoId], references: [id], onDelete: SetNull)

  @@map("fotos")
}


model RegistroCampo {
  id              String               @id @default(uuid())
  obraId          String               @map("obra_id")
  obra            Obra                 @relation(fields: [obraId], references: [id], onDelete: Cascade)
  engenheiroId    String               @map("engenheiro_id")
  engenheiro      Usuario              @relation("EngenheiroRegistros", fields: [engenheiroId], references: [id])
  dataVistoria    DateTime             @default(now()) @map("data_vistoria")
  status          StatusRegistro       @default(RASCUNHO)
  intercorrencias TipoIntercorrencia[]
  observacoes     String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  fotos           Foto[]

  @@map("registros_campo")
}
model TipoObra {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  descricao String?  @db.Text
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  etapasTemplate EtapaTemplate[]
  obras          Obra[]

  @@map("tipo_obras")
}

model EtapaTemplate {
  id                String             @id @default(uuid())
  tipoObraId        String             @map("tipo_obra_id")
  tipoObra          TipoObra           @relation(fields: [tipoObraId], references: [id], onDelete: Cascade)
  nome              String
  nomeCidadao       String             @map("nome_cidadao")
  descricao         String?            @db.Text
  ordem             Int
  peso              Int                @default(10)
  ehContinua        Boolean            @default(false) @map("eh_continua")
  ativa             Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  subEtapasTemplate SubEtapaTemplate[]
  etapasObra        EtapaObra[]

  @@unique([tipoObraId, ordem])
  @@map("etapas_template")
}

model SubEtapaTemplate {
  id              String         @id @default(uuid())
  etapaTemplateId String         @map("etapa_template_id")
  etapaTemplate   EtapaTemplate  @relation(fields: [etapaTemplateId], references: [id], onDelete: Cascade)
  nome            String
  descricao       String?        @db.Text
  ordem           Int
  peso            Int            @default(10)
  ativa           Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  subEtapasObra   SubEtapaObra[]

  @@unique([etapaTemplateId, ordem])
  @@map("sub_etapas_template")
}

model EtapaObra {
  id                  String         @id @default(uuid())
  obraId              String         @map("obra_id")
  obra                Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  etapaTemplateId     String         @map("etapa_template_id")
  etapaTemplate       EtapaTemplate  @relation(fields: [etapaTemplateId], references: [id])
  status              StatusEtapa    @default(PENDENTE)
  percentualConcluido Decimal        @default(0) @map("percentual_concluido") @db.Decimal(5, 2)
  dataInicio          DateTime?      @map("data_inicio")
  dataPrevisao        DateTime?      @map("data_previsao")
  dataConclusao       DateTime?      @map("data_conclusao")
  observacoes         String?        @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  subEtapasObra       SubEtapaObra[]

  @@unique([obraId, etapaTemplateId])
  @@map("etapas_obra")
}


model SubEtapaObra {
  id                 String           @id @default(uuid())
  etapaObraId        String           @map("etapa_obra_id")
  etapaObra          EtapaObra        @relation(fields: [etapaObraId], references: [id], onDelete: Cascade)
  subEtapaTemplateId String           @map("sub_etapa_template_id")
  subEtapaTemplate   SubEtapaTemplate @relation(fields: [subEtapaTemplateId], references: [id])
  status              StatusEtapa @default(PENDENTE)
  percentualConcluido Decimal     @default(0) @map("percentual_concluido") @db.Decimal(5, 2)
  dataInicio          DateTime?   @map("data_inicio")
  dataConclusao       DateTime?   @map("data_conclusao")
  observacoes         String?     @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([etapaObraId, subEtapaTemplateId])
  @@map("sub_etapas_obra")
}