generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
    ADMIN
    ENGENHEIRO
    CIDADAO
}

enum StatusObra {
    PLANEJADA
    ORDEM_EMITIDA
    EM_ANDAMENTO
    PARALISADA
    CONCLUIDA
}

enum TipoFoto {
    RENDER_PROJETO
    ANTES
    EM_ANDAMENTO
    CONCLUIDO
}

model Usuario {
    id String @id @default(uuid())
    nome String
    email String @unique
    cargo String?
    role Role @default(CIDADAO)
    createdAt DataTime @default(now()) @map("create_at")

    obrasFiscalizadas Obra[] @relation("EngenheiroObra)
    medicoes Medicao[]
    @@map("usuarios")
}

model Secretaria {
    id String @id @default(uuid())
    nome String
    sigla String
    corIdentificacao String? @map("cor_Identificacao")
    createdAt DataTime @default(now()) @map("create_at)

    obras Obra[]

    @@map("secretarias)
}